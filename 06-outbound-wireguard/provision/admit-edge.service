[Unit]
Description=Admit the edge site peer once its public key is published
After=wg-quick@wg0.service
Requires=wg-quick@wg0.service
ConditionPathExists=/vagrant/provision/hub-admit-edge.sh

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hub-admit-edge
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
